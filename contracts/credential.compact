pragma language_version >= 0.23;

import CompactStandardLibrary;

// Public ledger state stored on the Midnight blockchain
export ledger issuer: Bytes<32>;
export ledger commitments: Map<Bytes<32>, Boolean>;
export ledger revoked: Map<Bytes<32>, Boolean>;

// Circuit 1: Initialize contract with issuer authority identifier
export circuit initialize(issuerAuthority: Bytes<32>): [] {
    issuer = disclose(issuerAuthority);
}

// Circuit 2: Issuer publishes a cryptographic commitment hash of a credential
export circuit issue_credential(commitment: Bytes<32>): [] {
    const pubCommitment = disclose(commitment);
    assert(!commitments.member(pubCommitment), "Credential commitment already exists on-chain");
    commitments.insert(pubCommitment, true);
}

// Circuit 3: Issuer revokes an existing credential commitment
export circuit revoke_credential(commitment: Bytes<32>): [] {
    const pubCommitment = disclose(commitment);
    assert(commitments.member(pubCommitment), "Credential commitment does not exist on-chain");
    assert(!revoked.member(pubCommitment), "Credential commitment is already revoked");
    revoked.insert(pubCommitment, true);
}

// Circuit 4: Holder proves they possess a valid, currently unrevoked credential
// Private witnesses (holderId, credentialType, credentialValue, salt) remain completely private within the ZK circuit.
export circuit prove_credential(
    holderId: Bytes<32>,
    credentialType: Uint<64>,
    credentialValue: Uint<64>,
    salt: Bytes<32>
): Boolean {
    // Recompute commitment inside ZK circuit
    const commitment = persistentHash<[Bytes<32>, Uint<64>, Uint<64>, Bytes<32>]>([
        holderId,
        credentialType,
        credentialValue,
        salt
    ]);

    const pubCommitment = disclose(commitment);

    // Verify commitment exists in public ledger commitments map
    assert(commitments.member(pubCommitment), "Credential commitment not found on-chain");

    // Verify commitment is NOT in public ledger revoked map
    assert(!revoked.member(pubCommitment), "Credential has been revoked");

    return true;
}

// Circuit 5: Holder proves credential validity AND a custom predicate without revealing raw credential values
export circuit prove_credential_predicate(
    holderId: Bytes<32>,
    credentialType: Uint<64>,
    credentialValue: Uint<64>,
    salt: Bytes<32>,
    expectedType: Uint<64>,
    minScore: Uint<64>
): Boolean {
    // Recompute commitment inside ZK circuit
    const commitment = persistentHash<[Bytes<32>, Uint<64>, Uint<64>, Bytes<32>]>([
        holderId,
        credentialType,
        credentialValue,
        salt
    ]);

    const pubCommitment = disclose(commitment);

    // Verify commitment exists on-chain and is unrevoked
    assert(commitments.member(pubCommitment), "Credential commitment not found on-chain");
    assert(!revoked.member(pubCommitment), "Credential has been revoked");

    // Verify predicate conditions inside private ZK witness calculation
    assert(credentialType == expectedType, "Credential type mismatch");
    assert(credentialValue >= minScore, "Credential score is below required threshold");

    return true;
}
